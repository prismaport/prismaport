{{template "head" .}}
{{template "title" "A new way to get paid was added"}}
{{template "p" (printf "A wallet that receives payments was added to your Prismaport account (%s) on %s." .Data.Email .Data.When)}}
{{range .Data.Networks}}<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 16px 0;border:1px solid #d7dbe3;border-radius:8px;width:100%;"><tr>
{{if .Logo}}<td style="vertical-align:middle;padding:12px 0 12px 16px;width:32px;"><img src="cid:{{.Logo}}" width="32" height="32" alt="" style="display:block;border:0;border-radius:16px;"></td>
{{end}}<td style="vertical-align:middle;padding:12px 16px;"><span style="display:block;font-size:16px;line-height:24px;font-weight:600;color:#12141c;">{{.Name}}</span><span style="display:block;font-size:14px;line-height:21px;color:#4e5566;">{{.Detail}}</span></td>
</tr></table>
{{end}}{{template "p" "If you did this, there is nothing else to do."}}
{{template "p" "If you did not, reset your password now, then check your wallets and where each product pays in the dashboard."}}
{{template "button" (link .Data.ForgotURL "Reset your password")}}
{{template "foot" .}}
