{{define "head"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f8;color:#12141c;font-family:Onest,'Segoe UI',Arial,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{.Preview}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f8;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
<tr><td style="padding:0 0 16px 0;">
<table role="presentation" cellpadding="0" cellspacing="0"><tr>
<td style="vertical-align:middle;"><img src="cid:prismaport-icon" width="32" height="32" alt="" style="display:block;border:0;border-radius:8px;"></td>
<td style="vertical-align:middle;padding-left:8px;font-family:'Familjen Grotesk',Onest,'Segoe UI',Arial,sans-serif;font-size:20px;line-height:24px;font-weight:700;color:#12141c;">Prismaport</td>
</tr></table>
</td></tr>
<tr><td style="background:#ffffff;border:1px solid #d7dbe3;border-radius:8px;padding:32px 24px;">
{{end}}

{{define "foot"}}
</td></tr>
<tr><td style="padding:16px 4px 0 4px;font-size:12px;line-height:18px;color:#4e5566;">
Prismaport. Get paid in stablecoins, straight to your wallet.<br>
This is an automatic message about your Prismaport account. Replies are not read.
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
{{end}}

{{define "title"}}<h1 style="margin:0 0 16px 0;font-family:'Familjen Grotesk',Onest,'Segoe UI',Arial,sans-serif;font-size:24px;line-height:30px;font-weight:700;color:#12141c;">{{.}}</h1>{{end}}

{{define "p"}}<p style="margin:0 0 16px 0;font-size:16px;line-height:24px;color:#12141c;">{{.}}</p>{{end}}

{{define "muted"}}<p style="margin:0 0 16px 0;font-size:14px;line-height:21px;color:#4e5566;">{{.}}</p>{{end}}

{{define "code"}}<p style="margin:8px 0 24px 0;"><span style="display:inline-block;padding:12px 20px;background:#fbe8f0;border-radius:8px;font-family:'Geist Mono',Consolas,'Courier New',monospace;font-size:32px;line-height:40px;letter-spacing:8px;font-weight:500;color:#12141c;">{{.}}</span></p>{{end}}

{{define "button"}}<p style="margin:0 0 24px 0;"><a href="{{.URL}}" style="display:inline-block;padding:12px 20px;background:#b0185a;border-radius:8px;color:#ffffff;font-size:16px;line-height:20px;font-weight:600;text-decoration:none;">{{.Label}}</a></p>{{end}}

{{define "url"}}<p style="margin:0 0 16px 0;font-family:'Geist Mono',Consolas,'Courier New',monospace;font-size:13px;line-height:20px;color:#12141c;word-break:break-all;">{{.}}</p>{{end}}
