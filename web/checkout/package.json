{
  "name": "prismaport-checkout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean.mjs && tsc --noEmit && vite build && node scripts/check-dist.mjs dist",
    "typecheck": "tsc --noEmit",
    "logos": "node scripts/logos.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "uqr": "0.1.3",
    "viem": "2.57.19"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "jsdom": "31.0.1",
    "jsqr": "1.4.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
