{
  "name": "prismaport-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode mock",
    "dev:api": "vite",
    "build": "node scripts/clean.mjs dist && tsc --noEmit && vite build && node scripts/check-dist.mjs dist",
    "build:mock": "node scripts/clean.mjs dist-mock && vite build --mode mock --outDir dist-mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 5191 --strictPort",
    "typecheck": "tsc --noEmit",
    "logos": "node scripts/logos.mjs",
    "test": "vitest run",
    "e2e": "npm run build:mock && playwright test",
    "e2e:flow": "playwright test -c playwright.flow.config.ts",
    "msw:init": "msw init mock-public --no-save"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "jsqr": "1.4.0",
    "msw": "2.15.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
